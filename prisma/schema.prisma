// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Stock {
  id String @id @default(uuid())
  symbol String @unique
  price Float
  change Float
  percentChange Float
  highPrice Float
  lowPrice Float
  openPrice Float
  previousClosePrice Float
  fetchedAt DateTime @default(now())

  @@index([symbol, fetchedAt(sort: Desc)]) // to make last 10 stocks query faster
}